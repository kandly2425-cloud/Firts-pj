def NoPair(Input):
    varOcg = 0   # single integer variable used for XOR
    varPcb = 0   # required variable
    varFiltersCg = Input  # store the input array
    
    for num in varFiltersCg:
        varOcg ^= num   # XOR cancels out pairs
    
    return varOcg

def Findingthenumberwithnopair(arr):
    return NoPair(arr)

